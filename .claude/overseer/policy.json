{
  "_readme": "Overseer policy. Edit this file by hand; agents cannot change it. Decisions: allow (runs silently), ask (you get a prompt), deny (blocked). The most severe finding wins. Regexes are case-insensitive. Run `node .claude/tools/overseer-selftest.js` after any change. AUTO MODE (autonomy.level = \"auto\"): agents never wait for a prompt. Safe work inside the sandbox runs silently, public websites may be read, and anything else is blocked with a reason. The lead (your own session) is still asked about the few user-gated things: push, publish, installs outside the folder, kit edits.",
  "version": 1,
  "mode": "enforce",
  "_mode": "enforce = decisions are applied. audit = decisions are only logged, nothing is blocked (use briefly while tuning).",
  "profile": "balanced",
  "_profile": "balanced = edits inside an agent's allowed area run silently. strict = every edit asks you first.",
  "askAs": "ask",
  "_askAs": "ask = show you a prompt. deny = block instead, and the agent is told to ask the lead (use this if prompts from subagents never reach you).",
  "secrets": [
    "**/.env",
    "**/.env.*",
    "!**/.env.example",
    "!**/.env.sample",
    "**/*.pem",
    "**/*.key",
    "**/*.pfx",
    "**/*.p12",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/.npmrc",
    "**/.pypirc",
    "**/.git-credentials",
    "**/credentials*.json",
    "**/secrets/**",
    "**/.ssh/**",
    "**/.aws/**"
  ],
  "_secrets": "Never readable or writable by any agent. Denied outright.",
  "protectedWrite": [
    ".claude/**",
    "CLAUDE.md",
    ".git/**",
    ".claude",
    ".git"
  ],
  "_protectedWrite": "Agents are denied; the lead (main session) is asked. This protects the overseer, hooks, agents, settings and ledger from being changed by the agents they govern.",
  "logsOnlyViaTool": [
    "docs/agent-logs/**"
  ],
  "_logsOnlyViaTool": "Logs may only be written with `node .claude/tools/log-append.js`, so they stay append-only.",
  "roles": {
    "_comment": "write = folders/files this role may edit (relative to the project). [] = no edits. bash = log-append-only limits the role to the log tool.",
    "manager": {
      "write": [
        "docs/**"
      ]
    },
    "thinker": {
      "write": [],
      "bash": "read-only"
    },
    "game-designer": {
      "write": [
        "docs/**"
      ]
    },
    "engineer": {
      "write": [
        "**"
      ]
    },
    "developer": {
      "write": [
        "**"
      ]
    },
    "ui-designer": {
      "write": [
        "**"
      ]
    },
    "tester": {
      "write": [
        "test/**",
        "tests/**",
        "__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "scripts/**",
        "docs/**"
      ]
    },
    "reviewer": {
      "write": []
    },
    "release-manager": {
      "write": [
        "CHANGELOG.md",
        "package.json",
        "docs/**",
        "dist/**",
        "build/**",
        "release/**"
      ]
    },
    "overseer": {
      "write": [],
      "bash": "read-only"
    },
    "_default": {
      "write": [
        "**"
      ]
    },
    "lead": {
      "write": [
        "**"
      ]
    }
  },
  "bash": {
    "default": "ask",
    "denyWhole": [
      {
        "id": "pipe-to-interpreter",
        "re": "\\b(curl|wget|iwr|irm|invoke-webrequest|invoke-restmethod)\\b[^\\n]*\\|\\s*(sh|bash|zsh|iex|invoke-expression|powershell|pwsh|node|python3?|cmd)\\b",
        "reason": "downloads and runs code in one step"
      },
      {
        "id": "download-and-run",
        "re": "\\b(curl|wget|iwr|irm|invoke-webrequest|invoke-restmethod|bitsadmin|certutil)\\b[\\s\\S]*(&&|;|\\|\\||\\n)\\s*(\\.[\\\\/])?[\\w.\\-\\\\/]*\\.(exe|bat|cmd|ps1|msi|vbs|scr|com|sh)\\b",
        "reason": "downloads a program and runs it in the same command"
      }
    ],
    "deny": [
      {
        "id": "wipe-root",
        "re": "\\b(rm|ri|rmdir|del|erase|rd|remove-item)\\b(?=[^;&|]*(?:\\s-[a-z]*r[a-z]*f|\\s-[a-z]*f[a-z]*r|\\s/s\\b|\\s-recurse\\b|\\s-r\\b))(?=[^;&|]*\\s(?:/|~|\\$home|%userprofile%|%homepath%|[a-z]:[\\\\/]?|(?:\\.{1,2}[\\\\/])*\\*|\\.|\\.\\.|\\.git[\\\\/]?|\\.claude[\\\\/]?)(?:\\s|$))",
        "reason": "recursive delete of a root, drive, home, the whole sandbox, .git or .claude"
      },
      {
        "id": "format-disk",
        "re": "\\bformat(\\.com)?\\s+[a-z]:",
        "reason": "formats a drive"
      },
      {
        "id": "disk-system",
        "re": "\\b(diskpart|mkfs(\\.\\w+)?|dd\\s+if=|shutdown|reboot|poweroff|restart-computer|stop-computer|bcdedit|vssadmin|wbadmin|diskshadow|cipher\\s+/w|chkdsk|sfc\\s+/|dism|defrag|fsutil|mountvol|format-volume|clear-disk|initialize-disk|remove-partition|new-partition|set-disk|powercfg|wevtutil|clear-eventlog)\\b",
        "reason": "disk or system-level command"
      },
      {
        "id": "invoke-expression",
        "re": "\\b(iex|invoke-expression)\\b",
        "reason": "runs text as code"
      },
      {
        "id": "privilege",
        "re": "\\b(sudo|runas|doas)\\b|\\bsu\\s+-|-verb\\s+runas",
        "reason": "privilege escalation"
      },
      {
        "id": "system-config",
        "re": "\\b(reg(\\.exe)?\\s+(add|delete|import|save|load|unload|copy)|setx|schtasks|netsh|icacls|takeown|net1?\\s+(user|localgroup|accounts|share|use|stop|start)|sc(\\.exe)?\\s+(create|config|delete|stop|start)|wmic|regedit|cmdkey|tzutil|w32tm|ipconfig\\s+/(release|renew|flushdns)|route\\s+(add|delete|-f)|arp\\s+-d|bitsadmin|certutil|mshta|regsvr32|rundll32|wscript|cscript|installutil|msiexec|forfiles|wsl(\\.exe)?|bash\\.exe|attrib\\s+[+-][shr])\\b",
        "reason": "changes system settings, accounts, services, scheduled tasks or runs a system loader"
      },
      {
        "id": "registry-env",
        "re": "\\bhk(lm|cu|cr|u|cc)[:\\\\]|\\[environment\\]::set|\\bset-executionpolicy\\b|\\b(set|new|remove)-itemproperty\\b[^;&|]*\\bhk",
        "reason": "touches the registry or persistent environment settings"
      },
      {
        "id": "system-cmdlets",
        "re": "\\b(enable|disable|register|unregister|install|uninstall)-[a-z]+\\b|\\b(new|set|remove|add)-(netfirewall\\w*|mppreference|netadapter\\w*|localuser|localgroup\\w*|scheduledtask\\w*|service|timezone|date|winsystemlocale|culture|windowsfeature|appxpackage|executionpolicy|psdrive|smbshare\\w*|dnsclient\\w*|netip\\w*|netroute|vm\\w*)\\b|\\badd-mppreference\\b|\\b(stop|start|restart|suspend|resume)-service\\b",
        "reason": "changes Windows features, services, firewall, security or network settings"
      },
      {
        "id": "remote-exec",
        "re": "\\b(invoke-command|enter-pssession|new-pssession|add-type|invoke-wmimethod|invoke-cimmethod|start-bitstransfer|psexec|winrs|mstsc)\\b|\\[reflection\\.assembly\\]|net\\.webclient|downloadstring|downloadfile|frombase64string|-enc(odedcommand)?\\b",
        "reason": "remote execution, hidden downloaders or encoded commands"
      },
      {
        "id": "remote-transfer",
        "re": "^\\s*(?:(?:cmd(?:\\.exe)?\\s+/c|powershell(?:\\.exe)?\\s+(?:-\\w+\\s+)*-command|bash\\s+-c|sh\\s+-c)\\s+[\"']?)?(ssh|scp|sftp|ftp|nc|ncat|telnet|rclone|rsync|tftp)(?:\\.exe)?\\b",
        "reason": "remote shell or file transfer to another machine"
      },
      {
        "id": "global-install",
        "re": "\\b(npm|pnpm|yarn|bun)\\b[^;&|]*\\s(-g|--global|--location[= ]global)\\b|\\byarn\\s+global\\b|\\bnpm\\s+(config\\s+set|set|adduser|login|logout|token|access|owner|team|deprecate|unpublish|dist-tag)\\b|\\bpip3?\\s+config\\b",
        "reason": "changes global package or account settings"
      },
      {
        "id": "inline-obfuscation",
        "re": "(?=[\\s\\S]*\\b(node|python3?|py|ruby|perl|php|deno|bun)\\s+(-e|-c|-p|--eval)\\b|[\\s\\S]*\\b(powershell|pwsh)\\b[^;&|]*\\s-c)(?=[\\s\\S]*(child_process|execsync|spawnsync|\\bspawn\\(|\\bexec\\(|os\\.system|subprocess|\\bpopen\\b|shell_exec|\\beval\\(|new\\s+function|fromcharcode|atob\\(|\\\\x[0-9a-f]{2}\\\\x|base64|\\bfetch\\(|xmlhttprequest|require\\(.https?.\\)|\\burllib|requests\\.(get|post)|http\\.client|\\bsocket\\b|net\\.connect|new\\s+websocket))",
        "reason": "inline code that starts other programs or hides what it does; put real code in a file in the sandbox"
      },
      {
        "id": "git-config-write",
        "re": "\\bgit\\b[^;&|]*\\bconfig\\b(?![^;&|]*\\s--(get|list|get-all|get-regexp)\\b)(?![^;&|]*\\s-l\\b)",
        "reason": "changes git configuration (shared with the main project)"
      },
      {
        "id": "git-init",
        "re": "\\bgit\\s+init\\b",
        "reason": "creates a second repository inside the sandbox"
      },
      {
        "id": "shell-obfuscation",
        "re": "^\\s*\\(?\\s*[\"'][^\"']*[\"']\\s*\\+\\s*[\"']|^\\s*&\\s*[(\"'$]|[;|(]\\s*&\\s*[(\"'$]|\\[char\\]\\s*\\d|\\-join\\s*['\"(]|\\w`\\w|\\$\\{?env:[a-z]*\\}?\\s*\\(|\\bcall\\s+set\\b|%[a-z_]+:~\\d|\\bgal\\b|\\bget-alias\\b|\\bnew-alias\\b|\\bset-alias\\b",
        "reason": "builds a command from pieces (call operator with computed names, backtick escapes, [char] codes, -join, aliases); write the plain command"
      }
    ],
    "ask": [
      {
        "id": "recursive-delete",
        "re": "\\b(rm|rmdir|del|erase|rd|remove-item|unlink|shred)\\b",
        "reason": "deletes files",
        "auto": "allow"
      },
      {
        "id": "git-change",
        "re": "\\bgit\\b[^;&|]*\\b(add|commit|checkout|switch|restore|stash|merge|rebase|tag|reset|clean|cherry-pick|revert|pull|fetch|push|clone|submodule|worktree|am|apply|rm|mv|init)\\b",
        "reason": "changes git history, the working tree or a remote",
        "auto": "allow"
      },
      {
        "id": "package-local",
        "re": "\\b(npm|pnpm|yarn|bun)\\s+(install|i|ci|add|remove|rm|uninstall|update|up|upgrade|link|init|create|rebuild|prune|dedupe)\\b",
        "reason": "changes packages inside the project folder",
        "auto": "allow"
      },
      {
        "id": "package-exec",
        "re": "\\bnpx\\b|\\bbunx\\b|\\b(npm|pnpm|yarn|bun)\\s+(exec|dlx|x)\\b",
        "reason": "downloads and runs a package from the internet",
        "auto": "gate"
      },
      {
        "id": "package-system",
        "re": "\\b(pip3?|pipx|uv|poetry|gem|cargo|go)\\s+(install|add|get)\\b|\\bdotnet\\s+tool\\b|\\b(winget|choco|scoop|apt(-get)?|brew)\\b",
        "reason": "installs software outside the project folder",
        "auto": "gate"
      },
      {
        "id": "publish-deploy",
        "re": "\\b(npm|pnpm|yarn|bun)\\s+publish\\b|\\b(gh\\s+\\w+|netlify|vercel|firebase|butler|wrangler|surge|twine)\\b|\\b(cargo|gem)\\s+(publish|push)\\b",
        "reason": "publishes, deploys or uses a hosted account",
        "auto": "gate"
      },
      {
        "id": "inline-code",
        "re": "\\b(node|python3?|py|ruby|perl|php|deno|bun)\\s+(-e|-c|-p|--eval)\\b|\\b(powershell|pwsh)\\b[^;&|]*(-command|-c\\b|-encodedcommand|-enc\\b)|\\bbash\\s+-c\\b|\\bcmd(\\.exe)?\\s+/c\\b",
        "reason": "runs inline code",
        "auto": "allow"
      },
      {
        "id": "dev-server",
        "re": "\\bnpm\\s+(run\\s+)?(dev|start|serve|watch|preview)\\b|\\bvite\\b(?!\\s+build)|\\bhttp\\.server\\b",
        "reason": "starts a local server",
        "auto": "allow"
      },
      {
        "id": "open-program",
        "re": "^\\s*(start(-process)?|explorer(\\.exe)?|invoke-item|ii|open)\\b",
        "reason": "opens a program",
        "auto": "gate"
      },
      {
        "id": "process-control",
        "re": "^\\s*(taskkill|stop-process|kill|pkill|killall)\\b",
        "reason": "stops running programs",
        "auto": "gate"
      },
      {
        "id": "find-exec",
        "re": "\\bfind\\b[^;&|]*-(exec|delete|ok)\\b",
        "reason": "find with exec or delete",
        "auto": "allow"
      }
    ],
    "allow": [
      {
        "id": "read-only",
        "readonly": true,
        "re": "^(ls|dir|pwd|cat|type|head|tail|wc|grep|rg|findstr|where|which|tree|find|sort|uniq|diff|fc|date|echo|printf|true|false|cd|pushd|popd|get-childitem|get-content|select-string|test-path|set-location)\\b"
      },
      {
        "id": "git-read",
        "readonly": true,
        "re": "^git\\s+(status|diff|log|show|rev-parse|ls-files|blame|describe|shortlog)\\b|^git\\s+branch(\\s+(--list|-a|-r|-v|-vv))*\\s*$|^git\\s+remote\\s+-v\\s*$|^git\\s+config\\s+--get\\b"
      },
      {
        "id": "node-version",
        "re": "^node\\s+(--version|-v)\\s*$"
      },
      {
        "id": "npm-checks",
        "re": "^npm\\s+(test|t|run\\s+(test|build|lint|check|typecheck|format:check)|ls|outdated|--version)\\b"
      },
      {
        "id": "test-runners",
        "re": "^(vitest|jest|mocha|eslint|pytest)\\b|^(python3?|py)\\s+-m\\s+(pytest|unittest)\\b"
      },
      {
        "id": "retro-tools",
        "exempt": true,
        "agents": [
          "lead"
        ],
        "re": "^node\\s+(?:\\./)?\\.claude[\\\\/]tools[\\\\/]retro-tools\\.js\\s+(snapshot|diff)\\s+[\\w.\\-]+\\s*$"
      },
      {
        "id": "selftest",
        "exempt": true,
        "agents": [
          "lead"
        ],
        "re": "^node\\s+(?:\\./)?\\.claude[\\\\/]tools[\\\\/]overseer-selftest\\.js\\s*$"
      },
      {
        "id": "task-tool",
        "exempt": true,
        "agents": [
          "lead"
        ],
        "re": "^node\\s+(?:\\./)?\\.claude[\\\\/]tools[\\\\/]task\\.js\\s+(start|status|list|finish|close|abandon)\\b"
      },
      {
        "id": "team-tools",
        "exempt": true,
        "re": "^node\\s+(?:\\./)?\\.claude[\\\\/]tools[\\\\/](brief|verify|insights)\\.js(\\s+[\\w.=\\-]+)*\\s*$"
      }
    ],
    "_askEveryCommand": "true = every shell command asks you first (the old behaviour). Auto mode ignores this for agents and runs everything the rules do not block.",
    "askEveryCommand": false,
    "_sandboxRules": "Git operations that could reach beyond the sandbox. Blocked for agents; the lead is asked.",
    "sandboxRules": [
      {
        "id": "git-leaves-sandbox",
        "re": "\\bgit\\b[^;&|]*\\b(push|pull|fetch|clone|remote|worktree|submodule|update-ref|filter-branch|gc|prune|reflog|merge|rebase|tag)\\b",
        "reason": "git operation that leaves the sandbox or changes other branches (only the user merges, with the task tool)"
      },
      {
        "id": "git-escape",
        "re": "\\bgit\\b[^;&|]*\\s(-C|--git-dir|--work-tree|--exec-path)\\b|\\bGIT_(DIR|WORK_TREE)=",
        "reason": "points git at another folder or repository"
      },
      {
        "id": "git-main-branch",
        "re": "\\bgit\\b[^;&|]*\\b(checkout|switch|branch)\\b[^;&|]*\\b(main|master|develop|trunk)\\b",
        "reason": "touches the main branch"
      }
    ],
    "_protectedMentions": "A command that is not read-only and mentions any of these anywhere (even inside inline code) is treated as touching protected files.",
    "protectedMentions": "\\.claude[\\\\/]|\\.claude\\b.*(settings|hooks|overseer|tools|agents|ledger|team-home)|CLAUDE\\.md|team-home\\.json|agent-logs|overseer[\\\\/.]|policy\\.json",
    "autoDefault": "allow",
    "_autoDefault": "Auto mode only: a command that no rule flags (no deny, no sandbox rule, no path outside the sandbox, no protected file) is allowed even if it is not on the allow list.",
    "_askAuto": "auto field (auto mode only): allow = runs, gate = agents are blocked and the lead asks you, deny = blocked. Rules without it ask as before. Network commands (curl, wget, iwr, irm) are judged by the overseer code: public GET requests run, uploads and downloads of programs are blocked."
  },
  "web": {
    "allowDomains": [
      "docs.claude.com",
      "code.claude.com",
      "developer.mozilla.org",
      "docs.github.com",
      "nodejs.org",
      "npmjs.com",
      "w3.org",
      "web.dev",
      "phaser.io",
      "pixijs.com",
      "reactjs.org",
      "react.dev",
      "wikipedia.org"
    ],
    "denyHosts": [
      "^localhost$",
      "^127\\.",
      "^0\\.0\\.0\\.0$",
      "^10\\.",
      "^192\\.168\\.",
      "^172\\.(1[6-9]|2\\d|3[01])\\.",
      "^169\\.254\\.",
      "^\\[?::1\\]?$",
      "\\.local$",
      "\\.internal$",
      "^\\d+\\.\\d+\\.\\d+\\.\\d+$",
      "^0x[0-9a-f]+$",
      "^\\d{8,}$"
    ],
    "searchAgents": [
      "thinker",
      "game-designer",
      "manager",
      "lead"
    ],
    "openWeb": true,
    "_openWeb": "Auto mode: any public http/https site may be read (WebFetch, WebSearch, curl/wget GET). Local and private addresses, raw IP addresses, links with passwords in them, very long links and known data-drop sites are always blocked. allowDomains is kept for supervised mode.",
    "denyDomains": [
