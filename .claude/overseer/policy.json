  "_sandbox": "required = agents may only change files inside a task sandbox (a separate git worktree). With no sandbox active, agents cannot edit the main app at all.",
  "sandbox": {
    "required": true
  },
  "gates": {
    "_comment": "Before the user merges a task, each role below must have recorded one of the listed verdicts on the exact final commit. The task tool checks this; agents cannot merge.",
    "verdicts": {
      "tester": [
        "ready",
        "not-ready"
      ],
      "reviewer": [
        "approve",
        "request-changes"
      ],
      "overseer": [
        "clear",
        "block"
      ]
    },
    "required": {
      "tester": [
        "ready"
      ],
      "reviewer": [
        "approve"
      ],
      "overseer": [
        "clear"
      ],
      "verify": [
        "pass"
      ]
    },
    "kitPaths": [
      ".claude/**",
      "CLAUDE.md",
      ".gitignore"
    ],
    "_verify": "The verify gate is written by `node .claude/tools/verify.js` when the checks pass on a clean tree at the exact final commit."
  },
  "autonomy": {
    "_comment": "auto = no prompts for agents. Allowed: file work inside the task sandbox within each role scope, shell commands that only touch the sandbox, git add/commit/branch work inside the sandbox, local npm install, public websites (read only). Blocked for agents (asked of the lead, i.e. you): push or any change to a remote, publishing, installs outside the folder, opening programs, process kills. Blocked for everyone: system settings, registry, services, accounts, disks, scheduled tasks, privilege escalation, remote shells, uploads, download-and-run, anything outside the sandbox. supervised = the old behaviour (every shell command asks you).",
    "level": "auto",
    "agentAsk": "deny",
    "openWeb": true,
    "maxUrlLength": 1500,
    "repeatBlockLimit": 3
  }
}
